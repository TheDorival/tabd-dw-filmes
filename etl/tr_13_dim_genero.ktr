<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_13_dim_genero</name>
    <description>Insere em DIM_GENERO os generos do TMDB (genres_raw) e os da base de vendas (Movie_Genre, com 'Sci-Fi' mapeado para 'Science Fiction'), apenas os que ainda nao existem (SCD Tipo 1). A dimensao e compartilhada pelas duas tabelas fato.</description>
    <directory>/</directory>
    <trans_type>Normal</trans_type>
    <size_rowset>10000</size_rowset>
    <created_user>-</created_user>
    <created_date>2026/10/26 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <connection>
    <name>dw_filmes</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_filmes</database>
    <port>55432</port>
    <username>dw_filmes</username>
    <password>Encrypted 2be98afc86aa7f280bc26a879d29faac9</password>
  </connection>
  <order>

  </order>
  <step>
    <name>Carrega DIM_GENERO</name>
    <type>ExecSQL</type>
    <copies>1</copies>
    <connection>dw_filmes</connection>
    <sql>insert into sch_dw_filmes.dim_genero (sk_genero, nome_genero)
select nextval('sch_dw_filmes.seq_dim_genero'), t.nome_genero
from (
  select trim(g) as nome_genero
  from sch_dw_filmes.stg_tmdb_movies, unnest(string_to_array(genres_raw, '|')) as g
  where trim(g) &lt;&gt; ''
  union
  select case trim(movie_genre) when 'Sci-Fi' then 'Science Fiction' else trim(movie_genre) end
  from sch_dw_filmes.stg_cinema_hall
) t
where not exists (
  select 1 from sch_dw_filmes.dim_genero d where d.nome_genero = t.nome_genero
);</sql>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quote_string>N</quote_string>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
</transformation>
