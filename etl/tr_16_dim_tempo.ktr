<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_16_dim_tempo</name>
    <description>Gera o calendario completo (DIM_TEMPO) cobrindo o intervalo de release_date observado em stg_tmdb_movies, com a classificacao derivada JANELA_MERCADO segundo o Quadro 4 da Parte 1 (mercado norte-americano, referencia das bases de origem): Fim de Ano (15/11 a 31/12), Verao/alta temporada (01/05 a 31/08), Janela de premiacoes (01/01 a 28-29/02) e Regular (demais datas). Insere as datas novas e reclassifica a janela das datas ja existentes, para que uma alteracao no calendario se aplique tambem ao historico.</description>
    <directory>/</directory>
    <trans_type>Normal</trans_type>
    <size_rowset>10000</size_rowset>
    <created_user>-</created_user>
    <created_date>2026/10/26 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <connection>
    <name>dw_filmes</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_filmes</database>
    <port>55432</port>
    <username>dw_filmes</username>
    <password>Encrypted 2be98afc86aa7f280bc26a879d29faac9</password>
  </connection>
  <order>
  </order>
  <step>
    <name>Carrega DIM_TEMPO</name>
    <type>ExecSQL</type>
    <copies>1</copies>
    <connection>dw_filmes</connection>
    <sql>insert into sch_dw_filmes.dim_tempo
  (sk_tempo, data, ano, semestre, trimestre, mes, nom_mes, dia, dia_semana, ind_fim_semana, ano_mes, janela_mercado)
select
  nextval('sch_dw_filmes.seq_dim_tempo'),
  d.dia_calendario,
  extract(year from d.dia_calendario)::int,
  case when extract(month from d.dia_calendario) &lt;= 6 then 1 else 2 end,
  extract(quarter from d.dia_calendario)::int,
  extract(month from d.dia_calendario)::int,
  case extract(month from d.dia_calendario)::int
    when 1 then 'Janeiro' when 2 then 'Fevereiro' when 3 then 'Marco' when 4 then 'Abril'
    when 5 then 'Maio' when 6 then 'Junho' when 7 then 'Julho' when 8 then 'Agosto'
    when 9 then 'Setembro' when 10 then 'Outubro' when 11 then 'Novembro' else 'Dezembro' end,
  extract(day from d.dia_calendario)::int,
  case extract(dow from d.dia_calendario)::int
    when 0 then 'Domingo' when 1 then 'Segunda-feira' when 2 then 'Terca-feira' when 3 then 'Quarta-feira'
    when 4 then 'Quinta-feira' when 5 then 'Sexta-feira' else 'Sabado' end,
  case when extract(dow from d.dia_calendario) in (0,6) then 1 else 0 end,
  to_char(d.dia_calendario, 'YYYY-MM'),
  case
    when (extract(month from d.dia_calendario) = 11 and extract(day from d.dia_calendario) &gt;= 15)
         or extract(month from d.dia_calendario) = 12 then 'Fim de Ano'
    when extract(month from d.dia_calendario) between 5 and 8 then 'Verao'
    when extract(month from d.dia_calendario) in (1,2) then 'Premiacoes'
    else 'Regular'
  end
from generate_series(
  (select min(release_date)::timestamp from sch_dw_filmes.stg_tmdb_movies),
  (select max(release_date)::timestamp from sch_dw_filmes.stg_tmdb_movies),
  interval '1 day'
) as d(dia_calendario)
where not exists (
  select 1 from sch_dw_filmes.dim_tempo t where t.data = d.dia_calendario::date
);

-- Reclassifica as datas ja existentes: uma alteracao no calendario do
-- Quadro 4 passa a valer tambem para o historico, sem recriar a dimensao.
update sch_dw_filmes.dim_tempo t
   set janela_mercado = case
         when (t.mes = 11 and t.dia &gt;= 15) or t.mes = 12 then 'Fim de Ano'
         when t.mes between 5 and 8 then 'Verao'
         when t.mes in (1,2) then 'Premiacoes'
         else 'Regular'
       end
 where t.janela_mercado is distinct from case
         when (t.mes = 11 and t.dia &gt;= 15) or t.mes = 12 then 'Fim de Ano'
         when t.mes between 5 and 8 then 'Verao'
         when t.mes in (1,2) then 'Premiacoes'
         else 'Regular'
       end;</sql>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quote_string>N</quote_string>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
</transformation>
