<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_02_stg_tmdb5000</name>
    <description>Extrai tmdb_5000_movies.csv (id do TMDB, orcamento e receita nominais) para stg_tmdb5000.</description>
    <directory>/</directory>
    <trans_type>Normal</trans_type>
    <size_rowset>10000</size_rowset>
    <created_user>-</created_user>
    <created_date>2026/10/26 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <connection>
    <name>dw_filmes</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_filmes</database>
    <port>55432</port>
    <username>dw_filmes</username>
    <password>Encrypted 2be98afc86aa7f280bc26a879d29faac9</password>
  </connection>
  <order>
    <hop><from>CSV Input</from><to>Select values</to><enabled>Y</enabled></hop>
    <hop><from>Select values</from><to>Table Output</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>CSV Input</name>
    <type>CsvInput</type>
    <copies>1</copies>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>Y</newline_possible>
    <filename>${Internal.Transformation.Filename.Directory}/../data/tmdb_5000_movies.csv</filename>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>budget</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>genres</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>homepage</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>id</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>keywords</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>original_language</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>original_title</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>overview</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>popularity</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>production_companies</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>production_countries</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>release_date</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>revenue</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>runtime</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>spoken_languages</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>status</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>tagline</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>title</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>vote_average</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>vote_count</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Select values</name>
    <type>SelectValues</type>
    <copies>1</copies>
    <fields>
      <field><name>id</name><rename>id_tmdb</rename></field>
      <field><name>budget</name></field>
      <field><name>revenue</name></field>
    </fields>
    <GUI><xloc>230</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Table Output</name>
    <type>TableOutput</type>
    <copies>1</copies>
    <connection>dw_filmes</connection>
    <schema>sch_dw_filmes</schema>
    <table>stg_tmdb5000</table>
    <commit>5000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <fields>
    </fields>
    <GUI><xloc>380</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
</transformation>
