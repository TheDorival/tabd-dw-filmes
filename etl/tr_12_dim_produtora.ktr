<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_12_dim_produtora</name>
    <description>Explode production_companies_raw (separador |), corrige a codificacao dos nomes e insere em DIM_PRODUTORA as produtoras que ainda nao existem (SCD Tipo 1; chave natural = nome).</description>
    <directory>/</directory>
    <trans_type>Normal</trans_type>
    <size_rowset>10000</size_rowset>
    <created_user>-</created_user>
    <created_date>2026/10/26 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <connection>
    <name>dw_filmes</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_filmes</database>
    <port>55432</port>
    <username>dw_filmes</username>
    <password>Encrypted 2be98afc86aa7f280bc26a879d29faac9</password>
  </connection>
  <order>

  </order>
  <step>
    <name>Carrega DIM_PRODUTORA</name>
    <type>ExecSQL</type>
    <copies>1</copies>
    <connection>dw_filmes</connection>
    <sql>insert into sch_dw_filmes.dim_produtora (sk_produtora, nome_produtora)
select nextval('sch_dw_filmes.seq_dim_produtora'), t.nome_produtora
from (
  select distinct sch_dw_filmes.fn_corrige_codificacao(trim(prod)) as nome_produtora
  from sch_dw_filmes.stg_tmdb_movies, unnest(string_to_array(production_companies_raw, '|')) as prod
  where trim(prod) &lt;&gt; ''
) t
where not exists (
  select 1 from sch_dw_filmes.dim_produtora d where d.nome_produtora = t.nome_produtora
);</sql>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quote_string>N</quote_string>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
</transformation>
