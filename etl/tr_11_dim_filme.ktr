<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_11_dim_filme</name>
    <description>Carrega DIM_FILME com SCD Tipo 2 via Dimension Lookup/Update (chave natural id_imdb). Titulo e sinopse passam pela correcao de codificacao; a classificacao indicativa vem do Rotten Tomatoes (stg_ponte_rt).</description>
    <directory>/</directory>
    <trans_type>Normal</trans_type>
    <size_rowset>10000</size_rowset>
    <created_user>-</created_user>
    <created_date>2026/10/26 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <connection>
    <name>dw_filmes</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_filmes</database>
    <port>55432</port>
    <username>dw_filmes</username>
    <password>Encrypted 2be98afc86aa7f280bc26a879d29faac9</password>
  </connection>
  <order>
    <hop><from>Table Input</from><to>Data de carga</to><enabled>Y</enabled></hop>
    <hop><from>Data de carga</from><to>Dimension Lookup/Update</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Table Input</name>
    <type>TableInput</type>
    <copies>1</copies>
    <connection>dw_filmes</connection>
    <sql>
select
  s.imdb_id,
  sch_dw_filmes.fn_corrige_codificacao(s.original_title) as titulo,
  sch_dw_filmes.fn_corrige_codificacao(s.original_title) as titulo_original,
  left(coalesce(sch_dw_filmes.fn_corrige_codificacao(s.overview), ''), 2000) as sinopse,
  s.runtime as duracao_minutos,
  nullif(r.content_rating, '') as classificacao_indicativa,
  s.release_year as ano_lancamento
from sch_dw_filmes.stg_tmdb_movies s
left join sch_dw_filmes.stg_ponte_rt p on p.imdb_id = s.imdb_id
left join sch_dw_filmes.stg_rt_filmes r on r.rt_link = p.rt_link
    </sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Data de carga</name>
    <type>SystemInfo</type>
    <copies>1</copies>
    <fields>
      <field>
        <name>data_carga</name>
        <type>system date (fixed)</type>
      </field>
    </fields>
    <GUI><xloc>230</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Dimension Lookup/Update</name>
    <type>DimensionLookup</type>
    <copies>1</copies>
    <schema>sch_dw_filmes</schema>
    <table>dim_filme</table>
    <connection>dw_filmes</connection>
    <commit>500</commit>
    <update>Y</update>
    <fields>
      <key>
        <name>imdb_id</name>
        <lookup>id_imdb</lookup>
      </key>
      <date>
        <name>data_carga</name>
        <from>dat_inicio_vigencia</from>
        <to>dat_fim_vigencia</to>
      </date>
      <field>
        <name>titulo</name>
        <lookup>titulo</lookup>
        <update>Insert</update>
      </field>
      <field>
        <name>titulo_original</name>
        <lookup>titulo_original</lookup>
        <update>Insert</update>
      </field>
      <field>
        <name>sinopse</name>
        <lookup>sinopse</lookup>
        <update>Insert</update>
      </field>
      <field>
        <name>duracao_minutos</name>
        <lookup>duracao_minutos</lookup>
        <update>Insert</update>
      </field>
      <field>
        <name>classificacao_indicativa</name>
        <lookup>classificacao_indicativa</lookup>
        <update>Insert</update>
      </field>
      <field>
        <name>ano_lancamento</name>
        <lookup>ano_lancamento</lookup>
        <update>Insert</update>
      </field>
      <return>
        <name>sk_filme</name>
        <rename/>
        <creation_method>sequence</creation_method>
        <use_autoinc>N</use_autoinc>
        <version>versao</version>
      </return>
    </fields>
    <sequence>seq_dim_filme</sequence>
    <min_year>1900</min_year>
    <max_year>9999</max_year>
    <cache_size>5000</cache_size>
    <preload_cache>N</preload_cache>
    <use_start_date_alternative>N</use_start_date_alternative>
    <start_date_alternative>none</start_date_alternative>
    <start_date_field_name/>
    <useBatch>N</useBatch>
    <GUI><xloc>380</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
</transformation>
