<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_19_br_filme_ator</name>
    <description>Recarrega a tabela-ponte de elenco para os filmes da carga atual a partir do IMDb: os cinco primeiros atores e atrizes na ordem de credito, com IND_PRINCIPAL = 1 para o primeiro (padrao excluir e reinserir por filme, idempotente).</description>
    <directory>/</directory>
    <trans_type>Normal</trans_type>
    <size_rowset>10000</size_rowset>
    <created_user>-</created_user>
    <created_date>2026/10/26 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <connection>
    <name>dw_filmes</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_filmes</database>
    <port>55432</port>
    <username>dw_filmes</username>
    <password>Encrypted 2be98afc86aa7f280bc26a879d29faac9</password>
  </connection>
  <order>

  </order>
  <step>
    <name>Recarrega BR_FILME_ATOR</name>
    <type>ExecSQL</type>
    <copies>1</copies>
    <connection>dw_filmes</connection>
    <sql>delete from sch_dw_filmes.br_filme_ator ba
where ba.sk_filme in (
  select df.sk_filme from sch_dw_filmes.dim_filme df
  join sch_dw_filmes.stg_tmdb_movies s on s.imdb_id = df.id_imdb
  where df.ind_atual = 1
);

insert into sch_dw_filmes.br_filme_ator (sk_filme, sk_ator, ordem_credito, ind_principal)
select df.sk_filme, da.sk_ator, min(p.ordem) as ordem_credito,
       case when min(p.ordem) = 1 then 1 else 0 end
from (
  select tconst, nconst,
         row_number() over (partition by tconst order by ordering::int) as ordem
  from sch_dw_filmes.stg_imdb_principais
  where category in ('actor', 'actress')
) p
join sch_dw_filmes.dim_filme df on df.id_imdb = p.tconst and df.ind_atual = 1
join sch_dw_filmes.dim_ator da on da.id_nconst = p.nconst
where p.ordem &lt;= 5
group by df.sk_filme, da.sk_ator;</sql>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quote_string>N</quote_string>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
</transformation>
