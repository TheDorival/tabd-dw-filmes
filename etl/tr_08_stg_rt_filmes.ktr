<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_08_stg_rt_filmes</name>
    <description>Extrai rotten_tomatoes_movies.csv para stg_rt_filmes (titulo, data, diretores, classificacao indicativa, Tomatometer e Audience Score).</description>
    <directory>/</directory>
    <trans_type>Normal</trans_type>
    <size_rowset>10000</size_rowset>
    <created_user>-</created_user>
    <created_date>2026/10/26 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <connection>
    <name>dw_filmes</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_filmes</database>
    <port>55432</port>
    <username>dw_filmes</username>
    <password>Encrypted 2be98afc86aa7f280bc26a879d29faac9</password>
  </connection>
  <order>
    <hop><from>CSV Input</from><to>Select values</to><enabled>Y</enabled></hop>
    <hop><from>Select values</from><to>Table Output</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>CSV Input</name>
    <type>CsvInput</type>
    <copies>1</copies>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>Y</newline_possible>
    <filename>${Internal.Transformation.Filename.Directory}/../data/rotten_tomatoes_movies.csv</filename>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>rotten_tomatoes_link</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>movie_title</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>movie_info</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>critics_consensus</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>content_rating</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>genres</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>directors</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>authors</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>actors</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>original_release_date</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>streaming_release_date</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>runtime</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>production_company</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>tomatometer_status</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>tomatometer_rating</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>tomatometer_count</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>audience_status</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>audience_rating</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>audience_count</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>tomatometer_top_critics_count</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>tomatometer_fresh_critics_count</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>tomatometer_rotten_critics_count</name><type>String</type><format></format><currency/><decimal></decimal><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Select values</name>
    <type>SelectValues</type>
    <copies>1</copies>
    <fields>
      <field><name>rotten_tomatoes_link</name><rename>rt_link</rename></field>
      <field><name>movie_title</name></field>
      <field><name>original_release_date</name></field>
      <field><name>directors</name></field>
      <field><name>content_rating</name></field>
      <field><name>tomatometer_rating</name></field>
      <field><name>tomatometer_count</name></field>
      <field><name>audience_rating</name></field>
      <field><name>audience_count</name></field>
    </fields>
    <GUI><xloc>230</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Table Output</name>
    <type>TableOutput</type>
    <copies>1</copies>
    <connection>dw_filmes</connection>
    <schema>sch_dw_filmes</schema>
    <table>stg_rt_filmes</table>
    <commit>5000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <fields>
    </fields>
    <GUI><xloc>380</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
</transformation>
