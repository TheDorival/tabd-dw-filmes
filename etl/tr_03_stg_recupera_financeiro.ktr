<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>tr_03_stg_recupera_financeiro</name>
    <description>Recupera filmes descartados por orcamento ou receita zerados quando o TMDB 5000 tem os dois valores. Os valores nominais sao corrigidos para US$ de 2010 com o fator do proprio TMDB Movies para o ano de lancamento (budget_adj / budget). Marca origem_financeiro = 'TMDB 5000'.</description>
    <directory>/</directory>
    <trans_type>Normal</trans_type>
    <size_rowset>10000</size_rowset>
    <created_user>-</created_user>
    <created_date>2026/10/26 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/17 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <connection>
    <name>dw_filmes</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>dw_filmes</database>
    <port>55432</port>
    <username>dw_filmes</username>
    <password>Encrypted 2be98afc86aa7f280bc26a879d29faac9</password>
  </connection>
  <order>

  </order>
  <step>
    <name>Recupera financeiro (TMDB 5000)</name>
    <type>ExecSQL</type>
    <copies>1</copies>
    <connection>dw_filmes</connection>
    <sql>insert into sch_dw_filmes.stg_tmdb_movies
  (imdb_id, id_tmdb, original_title, overview, runtime, release_year, release_date, director,
   cast_raw, genres_raw, production_companies_raw, vote_average, vote_count,
   budget, revenue, budget_adj, revenue_adj, origem_financeiro)
select distinct on (s.imdb_id)
       s.imdb_id, s.id_tmdb, s.original_title, s.overview, s.runtime, s.release_year, s.release_date,
       s.director, s.cast_raw, s.genres_raw, s.production_companies_raw, s.vote_average, s.vote_count,
       t5.budget::numeric, t5.revenue::numeric,
       round(t5.budget::numeric * f.fator, 2), round(t5.revenue::numeric * f.fator, 2), 'TMDB 5000'
  from sch_dw_filmes.stg_tmdb_sem_financeiro s
  join sch_dw_filmes.stg_tmdb5000 t5 on t5.id_tmdb = s.id_tmdb
  join (select release_year, avg(budget_adj / budget) as fator
          from sch_dw_filmes.stg_tmdb_movies
         where budget &gt; 0 and origem_financeiro = 'TMDB'
         group by release_year) f on f.release_year = s.release_year
 where t5.budget ~ '^[0-9]+$' and t5.revenue ~ '^[0-9]+$'
   and t5.budget::numeric &gt; 0 and t5.revenue::numeric &gt; 0
   and not exists (select 1 from sch_dw_filmes.stg_tmdb_movies m where m.imdb_id = s.imdb_id)
 order by s.imdb_id, t5.revenue::numeric desc;</sql>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quote_string>N</quote_string>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
</transformation>
